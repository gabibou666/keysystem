{
  "name": "keysystem",
  "version": "1.0.0",
  "description": "Roblox key system with LootLabs monetization, universal executor compatibility and auto-obfuscation",
  "main": "src/index.js",
  "type": "commonjs",
  "engines": {
    "node": ">=20 <25"
  },
  "scripts": {
    "start": "node src/index.js",
    "dev": "node --watch src/index.js",
    "migrate": "node src/migrate.js",
    "check": "node scripts/check-assets.js && node scripts/check-design.js && node scripts/check-cost.js && node scripts/check-schema.js && node scripts/check-dom.js",
    "check:design": "node scripts/check-design.js",
    "check:cost": "node scripts/check-cost.js",
    "check:schema": "node scripts/check-schema.js",
    "check:dom": "node scripts/check-dom.js",
    "db:target": "node scripts/db-target.js",
    "db:verify": "node scripts/verify-db.js",
    "db:capture-ca": "node scripts/capture-ca.js",
    "backup": "node scripts/backup-db.js",
    "restore": "node scripts/restore-db.js",
    "watchdog": "node scripts/watchdog.js",
    "test": "node test-crypto-config.js && node test-healthz-cache.js && node test-alerts.js && node test-session-token.js",
    "invite:ensure": "node scripts/ensure-discord-invite.js",
    "fonts": "python scripts/selfhost-fonts.py",
    "og": "python scripts/make-og-image.py",
    "pages:polish": "python scripts/polish-pages.py"
  },
  "dependencies": {
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-rate-limit": "^7.4.0",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.3",
    "pg": "^8.12.0"
  }
}
