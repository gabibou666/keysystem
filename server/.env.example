# ============ SERVEUR ============
# URL publique du site (Render: https://tonsite.onrender.com)
PUBLIC_URL=https://tonsite.onrender.com
PORT=3000

# ============ BASE DE DONNEES (Neon) ============
# Format: postgresql://user:password@host/dbname?sslmode=require
DATABASE_URL=postgresql://user:password@ep-xxxx.neon.tech/neondb?sslmode=require

# ============ SECRETS ============
# Generer avec: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
HMAC_SECRET=change_me_64_hex_chars
# Cle AES-256 pour chiffrer ton script original (32 bytes hex)
AES_KEY=change_me_64_hex_chars

# ============ LOOTLABS ============
# Token API depuis le panel LootLabs (onglet API) - REGENERE le tien, ne le partage jamais
LOOTLABS_API_KEY=your_lootlabs_api_token
# Tier des pubs: 1=Trending / 2=Gaming / 3=Profit Max / 4=Maximum Profit
LOOTLABS_TIER=2
# Theme de la page pub: 1=Classic / 2=Sims / 3=Minecraft / 4=GTA / 5=Space
LOOTLABS_THEME=1

# ============ ADMIN DISCORD OAUTH ============
# Depuis https://discord.com/developers/applications -> ton app -> OAuth2
DISCORD_CLIENT_ID=your_client_id
DISCORD_CLIENT_SECRET=your_client_secret
# Bot token (onglet Bot de ton app) - requis pour l'auto-join du serveur
DISCORD_BOT_TOKEN=your_bot_token
# ID de ton serveur Discord (clic droit sur le serveur -> Copier l'ID)
DISCORD_GUILD_ID=your_server_id
# Redirect URIs a renseigner dans Discord:
#   admin:    https://tonsite.onrender.com/admin/auth/callback
#   users:    https://tonsite.onrender.com/api/discord/callback
# Ton ID Discord (clic droit sur ton nom -> Copier l'ID utilisateur, mode dev requis)
ADMIN_DISCORD_IDS=123456789012345678

# ============ IA COMPATIBILITE (TokenRouter) ============
AI_BASE_URL=https://tokenrouter.ai/v1
AI_API_KEY=your_tokenrouter_key
AI_MODEL=model-name-here
