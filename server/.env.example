# ============ SERVEUR ============
# URL publique du site (Render: https://tonsite.onrender.com)
PUBLIC_URL=https://tonsite.onrender.com
PORT=3000

# ============ BASE DE DONNEES (Neon) ============
# Format: postgresql://user:password@host/dbname?sslmode=require
DATABASE_URL=postgresql://user:password@ep-xxxx.neon.tech/neondb?sslmode=require

# ============ SECRETS ============
# Generer avec: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
HMAC_SECRET=change_me_64_hex_chars
# Cle AES-256 pour chiffrer ton script original (32 bytes hex)
AES_KEY=change_me_64_hex_chars

# ============ LOOTLABS ============
# Token API depuis le panel LootLabs (onglet API) - REGENERE le tien, ne le partage jamais
LOOTLABS_API_KEY=your_lootlabs_api_token
# Tier des pubs: 1=Trending / 2=Gaming / 3=Profit Max / 4=Maximum Profit
# ATTENTION: LOOTLABS_TIER est la CATEGORIE d'annonces affichees (tier_id), PAS
# le nombre de publicites. Le nombre de pubs est le palier choisi par
# l'utilisateur (champ number_of_tasks, 1 a 5, doc officielle LootLabs): il est
# envoye par le serveur et grave dans la session (colonne ll_sessions.ad_count).
LOOTLABS_TIER=2
# Theme de la page pub: 1=Classic / 2=Sims / 3=Minecraft / 4=GTA / 5=Space
LOOTLABS_THEME=1
# Duree de la cle du palier "1 pub" (defaut 12)
LOOTLABS_DURATION_HOURS=12
# Duree de la cle du palier "2 pubs" (defaut 24)
LOOTLABS_DURATION_HOURS_2=24
# Palier "2 pubs" (24 h) propose sur /getkey. true (defaut) = carte affichee;
# false = carte masquee et /api/key/start le refuse proprement
# (reason=provider_unavailable), sans jamais toucher au palier "1 pub".
LOOTLABS_TIER2_ENABLED=true
# Secret partagé anti-bypass pour le postback: configure dans le panel LootLabs
# URL Postback dans LootLabs: https://tonsite.onrender.com/api/lootlabs/postback?click_id={puid}&secret=MON_SECRET
# Générer un secret: node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
LOOTLABS_POSTBACK_SECRET=

# ============ WORK.INK (regie n2 - optionnelle) ============
# Option 1 (Recommandee): Ton lien Work.ink cree sur dashboard.work.ink (ex: https://work.ink/xxxx)
# L'API officielle d'override Work.ink attachera dynamiquement le token et le puid sans cle API supplementaire.
WORKINK_LINK_URL=
# Option 2: Endpoint personnalise de la Link API (si tu utilises une API d'infrastructure)
WORKINK_LINK_ENDPOINT=
# Cle API de la Link API (si Option 2 utilisee)
WORKINK_API_KEY=
# Verification des tokens de completion (surchargeable pour des tests locaux)
WORKINK_VERIFY_URL=https://work.ink/_api/v2/token/isValid
# Secret partage optionnel de notre URL de retour (notre propre garde)
WORKINK_POSTBACK_SECRET=
# Duree de la cle apres 1 annonce Work.ink (defaut 24)
WORKINK_DURATION_HOURS=24

# ============ ADMIN DISCORD OAUTH ============
# Depuis https://discord.com/developers/applications -> ton app -> OAuth2
DISCORD_CLIENT_ID=your_client_id
DISCORD_CLIENT_SECRET=your_client_secret
# Bot token (onglet Bot de ton app) - requis pour l'auto-join du serveur
DISCORD_BOT_TOKEN=your_bot_token
# ID de ton serveur Discord (clic droit sur le serveur -> Copier l'ID)
DISCORD_GUILD_ID=your_server_id
# Redirect URIs a renseigner dans Discord:
#   admin:    https://tonsite.onrender.com/admin/auth/callback
#   users:    https://tonsite.onrender.com/api/discord/callback
# Ton ID Discord (clic droit sur ton nom -> Copier l'ID utilisateur, mode dev requis)
ADMIN_DISCORD_IDS=123456789012345678

# ============ PAIEMENT ROBUX (gamepass hub Roblox) ============
# Cree une experience "hub" neutre sur roblox.com + 1 gamepass par offre.
# Recupere les IDs dans la page du gamepass (URL: roblox.com/game-pass/ID/).
ROBUX_PASS_DAY1=
ROBUX_PASS_WEEK1=
ROBUX_PASS_MONTH1=
ROBUX_PASS_LIFETIME=
# Option B (Developer Products in-game): IDs des produits + secret du webhook
ROBUX_PRODUCT_DAY1=
ROBUX_PRODUCT_WEEK1=
ROBUX_PRODUCT_MONTH1=
ROBUX_PRODUCT_LIFETIME=
# Secret partage avec le script Luau du hub (Authorization: Bearer ...)
# Generer: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ROBUX_WEBHOOK_SECRET=
# Webhook Discord (Server Settings > Integrations > Webhooks) pour les
# notifications temps reel: ventes robux, cles delivrees, bans
DISCORD_WEBHOOK_URL=

# ============ IA COMPATIBILITE (TokenRouter) ============
AI_BASE_URL=https://tokenrouter.ai/v1
AI_API_KEY=your_tokenrouter_key
AI_MODEL=model-name-here

# Discord Bot API Bridge
DISCORD_BOT_API_URL=http://localhost:5000
DISCORD_BOT_API_SECRET=ks_discord_bot_secret_2026
# Invitation Discord PERMANENTE (sans expiration) affichee par le site.
# ATTENTION: une invitation temporaire = parcours casse le jour ou elle expire.
# Verifier/creer la bonne invitation: npm run invite:ensure
DISCORD_INVITE_URL=https://discord.gg/nrgtDK52Er
