# AUDIT HUB server
PUBLIC_URL=https://tonsite.onrender.com
# Optional public support links; unset/invalid values are hidden in the footer.
SUPPORT_EMAIL=
DISCORD_URL=
STATUS_URL=
# Public publisher identity; missing values remain visibly marked on /legal.
LEGAL_NAME=
LEGAL_EMAIL=
LEGAL_ADDRESS=
PORT=3000
DATABASE_URL=postgresql://user:password@host/database?sslmode=require
# Distinct and stable 64-character hexadecimal secrets
HMAC_SECRET=change_me_64_hex_chars
AES_KEY=change_me_different_64_hex_chars
# Optional developer sign-in; redirect /api/discord/callback
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
# Optional Google sign-in; redirect /api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Optional account verification/recovery email
RESEND_API_KEY=
AUTH_EMAIL_FROM=
# Optional operational alerts
DISCORD_WEBHOOK_URL=
TRUST_PROXY=1
# OWNER is derived only from a verified Discord OAuth identity. Never a browser-supplied ID.
OWNER_DISCORD_ID=899294059225579531
# Legacy bootstrap ADMIN account IDs; manage ongoing assignments in /admin/team.
MODERATION_ADMIN_IDS=
# Optional central Discord bot API; same strong secret in the bot hosting environment
BOT_API_URL=
BOT_API_SECRET=
HEALTHZ_DEEP_TTL_MIN=360
# Checkpoint credentials are managed per project in the dashboard.
